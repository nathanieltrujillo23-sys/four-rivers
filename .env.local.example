VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Error monitoring is a no-op until this is set — create a free
# project at sentry.io and paste its DSN here (and in Vercel's env vars).
VITE_SENTRY_DSN=

# Local-only, used solely by scripts/create-test-session.mjs for automated
# testing. NEVER expose this to the browser/client bundle. Keep out of git.
SUPABASE_SERVICE_ROLE_KEY=

# Full-Bible verse search for group leaders (server only, never VITE_ prefixed).
# KJV is built in. ESV and NLT are looked up through each publisher's free API:
#   ESV: https://api.esv.org   NLT: https://api.nlt.to  (the key TEST works locally, with limits)
# Set both in Vercel too. Without a key, that version says "not set up yet".
ESV_API_KEY=
NLT_API_KEY=

# Optional: NIV through API.Bible (https://scripture.api.bible). The NIV needs Biblica's permission for this
# use, so leave these empty until you have it. The id is the NIV's Bible id in your API.Bible account.
YOUVERSION_APP_KEY=
API_BIBLE_KEY=
API_BIBLE_NIV_ID=

# Optional: daily reading reminders (api/reminders.ts). Vercel Cron calls it once a day.
# CRON_SECRET is any long random string. Never put these in a VITE_ variable except the one public key.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
REMINDER_FROM=
# Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY; lets the browser subscribe this device.
VITE_VAPID_PUBLIC_KEY=

# Optional: automatic Spanish translation in the Admin dashboard (api/translate.ts).
ANTHROPIC_API_KEY=

# Optional: sign-in and sign-up bot check (Cloudflare Turnstile site key; see docs/sign-up-protection.md).
VITE_TURNSTILE_SITE_KEY=
